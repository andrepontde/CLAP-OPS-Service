POSTGRES_DB=clap_ops_service
POSTGRES_USER=clap_ops_service
POSTGRES_PASSWORD=change_this_password

# Use "db" as the host inside Docker Compose and "localhost" when running locally.
DATABASE_URL=postgresql+psycopg://clap_ops_service:change_this_password@localhost:5432/clap_ops_service

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
